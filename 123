SELECT 
    Claims.ClaimId,
    Claims.Version,
    Claims.Product,
    Claims.Benefit,
    Claims.CustomerLastName,
    Claims.CustomerFirstName,
    Claims.CertificateNumber,
    Payments.FaceAmount,
    Payments.IncidentDate,
    PaymentHistory.InsurerId,
    PaymentHistory.TransDate,
    Claims.CustomerProvince,

    -- ✅ Principal Amount
    SUM(
        IIF(
            (PaymentHistory.Recipient IN ('Beneficiary','Bank') 
             AND PaymentHistory.Type = 'Principal'),
            PaymentHistory.PaymentAmount,
            0
        )
    ) AS PrincipalAmt,

    -- ✅ Interest Amount
    SUM(
        IIF(
            (PaymentHistory.Recipient IN ('Beneficiary','Bank') 
             AND PaymentHistory.Type = 'Interest'),
            PaymentHistory.PaymentAmount,
            0
        )
    ) AS InterestAmt,

    -- ✅ Total Payment Amount
    SUM(PaymentHistory.PaymentAmount) AS PaymentAmt

FROM 
    (Claims 
    INNER JOIN PaymentHistory 
        ON Claims.ClaimId = PaymentHistory.ClaimId)
    INNER JOIN Payments 
        ON Claims.ClaimId = Payments.ClaimId

WHERE 
    PaymentHistory.InsurerId = 4
    AND PaymentHistory.TransDate 
        BETWEEN #<StartDate># AND #<EndDate>#

GROUP BY 
    Claims.ClaimId,
    Claims.Version,
    Claims.Product,
    Claims.Benefit,
    Claims.CustomerLastName,
    Claims.CustomerFirstName,
    Claims.CertificateNumber,
    Payments.FaceAmount,
    Payments.IncidentDate,
    PaymentHistory.InsurerId,
    PaymentHistory.TransDate,
    Claims.CustomerProvince;