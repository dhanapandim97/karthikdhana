import com.opencsv.CSVWriterBuilder;

import java.io.File;
import java.io.FileWriter;
import java.nio.file.Path;
import java.sql.*;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.*;

public class ClaimsJob {

    // ✅ Java 21 record
    record ClaimRow(
            String claimId,
            String version,
            String product,
            String benefit,
            String certificateNumber,
            LocalDate incidentDate,
            double paymentAmount,
            String recipient,
            String type,
            LocalDate transDate,
            String province
    ) {}

    // =========================
    // 1️⃣ EXECUTE
    // =========================
    public void execute() throws Exception {

        var csvFile = extractDataAndCreateCsv();

        var files = Map.of(
                csvFile, "/remote/path/output.csv" // 🔥 update
        );

        uploadFilesThroughSSH(files);
    }

    // =========================
    // 2️⃣ EXTRACT + CSV
    // =========================
    private File extractDataAndCreateCsv() throws Exception {

        var dbUrl = "jdbc:ucanaccess://E:/path/yourdb.accdb";
        var outputFile = Path.of("claims_output.csv").toFile();

        var sql = """
                SELECT Claims.ClaimId, Claims.Version, Claims.Product, Claims.Benefit,
                       Claims.CertificateNumber, Payments.IncidentDate,
                       PaymentHistory.PaymentAmount, PaymentHistory.Recipient,
                       PaymentHistory.Type, PaymentHistory.TransDate,
                       Claims.CustomerProvince
                FROM (Claims
                INNER JOIN PaymentHistory ON Claims.ClaimId = PaymentHistory.ClaimId)
                INNER JOIN Payments ON Claims.ClaimId = Payments.ClaimId
                WHERE PaymentHistory.InsurerId = ?
                AND PaymentHistory.TransDate BETWEEN ? AND ?
                """;

        var rows = new ArrayList<ClaimRow>();

        var principalMap = new HashMap<String, Double>();
        var interestMap = new HashMap<String, Double>();
        var paymentMap = new HashMap<String, Double>();

        try (var conn = DriverManager.getConnection(dbUrl);
             var ps = conn.prepareStatement(sql)) {

            ps.setInt(1, 4);
            ps.setDate(2, Date.valueOf("2024-01-01"));
            ps.setDate(3, Date.valueOf("2024-12-31"));

            try (var rs = ps.executeQuery()) {

                while (rs.next()) {

                    var row = new ClaimRow(
                            rs.getString("ClaimId"),
                            rs.getString("Version"),
                            rs.getString("Product"),
                            rs.getString("Benefit"),
                            rs.getString("CertificateNumber"),
                            toLocalDate(rs.getDate("IncidentDate")),
                            rs.getDouble("PaymentAmount"),
                            rs.getString("Recipient"),
                            rs.getString("Type"),
                            toLocalDate(rs.getDate("TransDate")),
                            rs.getString("CustomerProvince")
                    );

                    rows.add(row);

                    var claimId = row.claimId();
                    var amount = row.paymentAmount();

                    // ✅ Total payment
                    paymentMap.merge(claimId, amount, Double::sum);

                    // ✅ Principal / Interest using modern switch
                    switch (row.type()) {
                        case "Principal" -> {
                            if (isValidRecipient(row.recipient())) {
                                principalMap.merge(claimId, amount, Double::sum);
                            }
                        }
                        case "Interest" -> {
                            if (isValidRecipient(row.recipient())) {
                                interestMap.merge(claimId, amount, Double::sum);
                            }
                        }
                    }
                }
            }
        }

        writeCsv(outputFile, rows, principalMap, interestMap, paymentMap);

        return outputFile;
    }

    // =========================
    // CSV WRITING
    // =========================
    private void writeCsv(
            File file,
            List<ClaimRow> rows,
            Map<String, Double> principalMap,
            Map<String, Double> interestMap,
            Map<String, Double> paymentMap
    ) throws Exception {

        var formatter = DateTimeFormatter.ofPattern("dd-MMM-yy");
        var businessDate = "20250131";

        try (var writer = new FileWriter(file);
             var csvWriter = new CSVWriterBuilder(writer)
                     .withSeparator('|')
                     .build()) {

            // Header
            csvWriter.writeNext(new String[]{
                    "Product", "Benefit", "Version", "ClaimId", "CertificateNumber",
                    "IncidentDate", "PrincipalAmt", "InterestAmt", "PaymentAmt",
                    "Province", "ReportDate", "SourceSystem"
            });

            var count = 0;

            for (var row : rows) {

                var claimId = row.claimId();

                var principal = principalMap.getOrDefault(claimId, 0.0);
                var interest = interestMap.getOrDefault(claimId, 0.0);
                var payment = paymentMap.getOrDefault(claimId, 0.0);

                csvWriter.writeNext(new String[]{
                        safe(row.product()),
                        safe(row.benefit()),
                        safe(row.version()),
                        safe(claimId),
                        safe(row.certificateNumber()),
                        format(row.incidentDate(), formatter),
                        String.valueOf(principal),
                        String.valueOf(interest),
                        String.valueOf(payment),
                        safe(row.province()),
                        format(row.transDate(), formatter),
                        "CLMTR"
                });

                count++;
            }

            // Footer
            csvWriter.writeNext(new String[]{
                    String.valueOf(count),
                    businessDate
            });
        }
    }

    // =========================
    // SSH UPLOAD
    // =========================
    private void uploadFilesThroughSSH(Map<File, String> files) {
        System.out.println("Uploading: " + files);
    }

    // =========================
    // UTIL METHODS
    // =========================
    private static boolean isValidRecipient(String recipient) {
        return "Beneficiary".equals(recipient) || "Bank".equals(recipient);
    }

    private static LocalDate toLocalDate(Date date) {
        return Optional.ofNullable(date)
                .map(Date::toLocalDate)
                .orElse(null);
    }

    private static String format(LocalDate date, DateTimeFormatter formatter) {
        return Optional.ofNullable(date)
                .map(formatter::format)
                .orElse("");
    }

    private static String safe(String value) {
        return Optional.ofNullable(value).orElse("");
    }
}